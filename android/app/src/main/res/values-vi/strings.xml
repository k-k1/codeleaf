    <string name="settings_language_title">Ngôn ngữ</string>
    <string name="settings_language_desc">Đặt ngôn ngữ giao diện ứng dụng. \"Hệ thống\" theo ngôn ngữ thiết bị; ngôn ngữ không được hỗ trợ sẽ quay về tiếng Anh.</string>
