    <!-- Cài đặt: giao diện -->
    <string name="settings_theme_title">Giao diện mặc định</string>
    <string name="settings_theme_desc">Dùng cho màu của màn hình danh sách và cài đặt, và làm giao diện ban đầu khi thêm kho lưu trữ.</string>
    <string name="theme_system">Hệ thống</string>
    <string name="theme_light">Sáng</string>
    <string name="theme_dark">Tối</string>

    <!-- Cài đặt: cỡ chữ -->
    <string name="settings_font_title">Cỡ chữ</string>
    <string name="settings_font_desc">Áp dụng cho cỡ chữ nội dung của Markdown đã kết xuất và chế độ xem mã.</string>
    <string name="font_small">Nhỏ</string>
    <string name="font_medium">Vừa</string>
    <string name="font_large">Lớn</string>

    <!-- Cài đặt: biểu tượng tệp -->
    <string name="settings_iconset_title">Biểu tượng tệp</string>
    <string name="settings_iconset_desc">Giao diện của biểu tượng theo phần mở rộng trong danh sách. Material/VS Code đầy đủ màu; Seti là ký hiệu đơn sắc.</string>

    <!-- Cài đặt: hiển thị tên tệp -->
    <string name="settings_filename_title">Hiển thị tên tệp</string>
    <string name="settings_filename_desc">Cách xử lý tên dài. Ngắt dòng = hiển thị toàn bộ trên nhiều dòng. Lược giữa = giữ đầu và cuối. Lược cuối = cắt phần cuối bằng ….</string>
    <string name="filename_wrap">Ngắt dòng</string>
    <string name="filename_middle">Lược giữa</string>
    <string name="filename_end">Lược cuối</string>

    <!-- Cài đặt: công tắc danh sách tệp -->
    <string name="settings_collapse_title">Thu gọn thư mục đơn</string>
    <string name="settings_collapse_desc">Gộp chuỗi chỉ có một thư mục con thành một mục như src/main/java, giảm số lần chạm.</string>
    <string name="settings_commitinfo_title">Hiển thị thông tin commit</string>
    <string name="settings_commitinfo_desc">Hiển thị bản cập nhật cuối của mỗi tệp/thư mục (tác giả và thời điểm) dưới tên trong danh sách. Phải duyệt lịch sử nên có thể hơi chậm với kho lớn.</string>

    <!-- Cài đặt: kho lưu trữ -->
    <string name="settings_restore_title">Khôi phục vị trí lần trước</string>
    <string name="settings_restore_desc">Khi mở kho lưu trữ, khôi phục thư mục bạn đang ở và tệp đang mở. Khi tắt, luôn mở ở trên cùng và không mở tệp nào.</string>

    <!-- Cài đặt: trình xem -->
    <string name="settings_wrap_title">Ngắt dòng mã (mặc định)</string>
    <string name="settings_wrap_desc">Trạng thái ban đầu khi mở chế độ xem mã/raw. Khi tắt sẽ cuộn ngang.</string>
    <string name="settings_diffwrap_title">Ngắt dòng diff (mặc định)</string>
    <string name="settings_diffwrap_desc">Trạng thái ban đầu khi mở chế độ xem diff cho thay đổi, commit và lịch sử. Khi tắt sẽ cuộn ngang.</string>
    <string name="settings_linenum_title">Hiển thị số dòng</string>
    <string name="settings_linenum_desc">Thêm số dòng vào mỗi dòng trong chế độ xem mã/văn bản/raw.</string>
    <string name="settings_selecttext_title">Bật chọn văn bản theo mặc định</string>
    <string name="settings_selecttext_desc">Mở trình xem với văn bản nội dung có thể chọn để sao chép. Bạn cũng có thể bật/tắt theo từng trình xem từ ⋮. Khi bật, nhấn giữ để thêm ghi chú sẽ bị tắt.</string>
    <string name="settings_sticky_title">Ghim tiêu đề lên đầu</string>
    <string name="settings_sticky_desc">Trong Markdown đã kết xuất, ghim đường dẫn tiêu đề hiện tại (h1 &gt; h2 &gt; h3 …) lên đầu.</string>

    <!-- Cài đặt: bảng Markdown -->
    <string name="settings_table_title">Hiển thị bảng Markdown</string>
    <string name="settings_table_desc">Nội tuyến = ngắt dòng và nhúng vào nội dung (mặc định). Cuộn được = bảng có tiêu đề cố định và cuộn ngang.</string>
    <string name="table_inline">Nội tuyến</string>
    <string name="table_scrollable">Cuộn được</string>

    <!-- Cài đặt: liên kết -->
    <string name="settings_link_title">Cách mở liên kết ngoài</string>
    <string name="settings_link_desc">Mở liên kết http/https trong trình duyệt tích hợp (Custom Tabs) hay trình duyệt ngoài. Liên kết tương đối luôn điều hướng trong ứng dụng.</string>
    <string name="link_inapp">Trong ứng dụng</string>
